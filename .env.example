# Kopie nach .env.local (Punkt am Anfang!) und Werte eintragen. .env.local wird nicht ins Repo hochgeladen.
# Für die Live-Seite dieselben Namen unter GitHub → Settings → Secrets and variables → Actions → *Variables* anlegen.

# Supabase Realtime (Live-Teilnahme per Handy). Nur der öffentliche anon/publishable Key – nie den service_role/secret Key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google-Anmeldung + Drive (optional; leer = keine Anmeldung, keine Speicherung in Drive)
VITE_GOOGLE_CLIENT_ID=
# Nur Konten dieser Domain zulassen, z. B. i2d.de (optional)
VITE_ALLOWED_DOMAIN=
# Fester Zielordner in Drive/geteiltem Laufwerk (optional; verlangt vollen Drive-Zugriff statt drive.file)
VITE_DRIVE_FOLDER_ID=
